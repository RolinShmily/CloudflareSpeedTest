[Unit]
Description=CloudflareSpeedTest Dynamic DNS Updater
Documentation=https://github.com/XIU2/CloudflareSpeedTest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# 请根据实际部署路径修改 WorkingDirectory (例如 /root/CloudflareSpeedTest 或 /opt/CloudflareSpeedTest)
WorkingDirectory=/opt/CloudflareSpeedTest
ExecStart=/usr/bin/python3 .custom/main.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
