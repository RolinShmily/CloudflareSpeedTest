{
  "cloudflare": {
    "api_token": "YOUR_CLOUDFLARE_API_TOKEN",
    "zone_name": "example.com",
    "zone_id": "",
    "proxy": "",
    "record_names": [
      "*.cf.example.com"
    ],
    "record_type": "A",
    "ttl": 60,
    "proxied": false,
    "comment": "Auto-updated by CloudflareSpeedTest"
  },
  "speedtest": {
    "binary_path": "cfst",
    "ip_file": "ip.txt",
    "specified_ips": [],
    "test_url": "https://cf.example.com/download",
    "port": 443,
    "thread_count": 64,
    "ping_times": 4,
    "candidate_pool_size": 30,
    "download_time": 4,
    "httping": false,
    "httping_code": 200,
    "colo": "",
    "extra_args": []
  },
  "filter": {
    "target_ip_count": 10,
    "min_qualified_ips": 3,
    "sort_by": "delay",
    "diversify_colo": true,
    "max_per_colo": 0,
    "max_per_region": 0,
    "max_per_subnet": 2,
    "strict_colo_cap": false,
    "strict_subnet_cap": false,
    "exclude_colo": [],
    "include_colo": [],
    "min_delay_ms": 0.0,
    "max_delay_ms": 250.0,
    "max_loss_rate": 0.05,
    "min_speed_mb": 5.0
  },
  "schedule": {
    "interval_hours": 12,
    "random_delay_minutes": 0
  },
  "general": {
    "github_proxy": "https://gh-proxy.org/",
    "log_level": "INFO",
    "log_file": "cfst_ddns.log"
  }
}
