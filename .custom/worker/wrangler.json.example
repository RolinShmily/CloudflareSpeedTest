{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-speedtest-hub",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cf.example.com/*",
      "zone_name": "example.com"
    }
  ],
  "vars": {
    "BASE_DOMAIN": "cf.example.com"
  }
}
